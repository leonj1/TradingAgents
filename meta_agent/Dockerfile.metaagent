# Dockerfile for Meta-Agent Dynamic Topic Response System
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt /app/requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy the entire current directory as meta_agent module
COPY . /app/meta_agent/

# Create directories for results and logs
RUN mkdir -p /app/results /app/logs

# Set Python path to include the app directory
ENV PYTHONPATH=/app:$PYTHONPATH
ENV PYTHONUNBUFFERED=1

# Default environment variables (can be overridden)
ENV OPENAI_API_KEY=""
ENV LOG_LEVEL="INFO"

# Create a non-root user
RUN useradd -m -u 1000 metaagent && \
    chown -R metaagent:metaagent /app && \
    chmod 777 /app/results /app/logs

# USER metaagent  # Temporarily disabled for debugging

# Expose ports
# 8000 for FastAPI
# 8501 for Streamlit (if implemented)
EXPOSE 8000 8501

# Default command (can be overridden)
CMD ["python", "-m", "meta_agent.interfaces.cli", "interactive"]
# TradingAgents Environment Variables
# Copy this file to .env and fill in your API keys

# Required: FinnHub API Key for financial data
# Get your free API key at: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# Required: At least one LLM provider API key must be set

# OpenAI API Key (for GPT models)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google API Key (for Gemini models)
# Get your API key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic API Key (for Claude models)
# Get your API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Redis configuration (if using external Redis)
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Optional: Configuration overrides
# LLM_PROVIDER=openai  # Options: openai, google, anthropic
# DEEP_THINK_LLM=o4-mini
# QUICK_THINK_LLM=gpt-4o-mini
# MAX_DEBATE_ROUNDS=1
# MAX_RISK_DISCUSS_ROUNDS=1
# ONLINE_TOOLS=true